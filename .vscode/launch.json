  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Jsx",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "DEBUG": "cube:*"
      },
      "program": "${workspaceFolder}/bin/cube-start",
      "args": [
        "/Users/fish/workspace/PDA/view/src",
        "--no-cache"
      ],
      "outFiles": [
        "${workspaceFolder}/**/*.js"
      ]
    }
  ]
}